# Public project configuration (project must be dedicated to Szocial).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only elevated key: required for validated uploads and verified payment reconciliation.
SUPABASE_SECRET_KEY=
# Set to the actual application origin; register the same origin in Supabase Auth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-only Razorpay credentials. No mock-success fallback exists.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# For applying migrations through a secure direct/pooler connection, when MCP is unavailable.
# Do not expose this variable to Next.js browser code.
DATABASE_URL=
